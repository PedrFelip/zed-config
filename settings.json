// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "enabled": true,
  },
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night",
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "window_decorations": "server",
  "disable_ai": false,
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
  },
  "preferred_line_length": 80,
  "prettier": {},
  "vim_mode": false,
  "vim": {
    "cursor_shape": {
      "insert": "bar",
      "visual": "underline",
    },
  },
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
  "ui_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_size": 20.0,
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "format_on_save": "on",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
      "enable_thinking": false,
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/kimi-k2.5",
      "enable_thinking": false,
    },
    "commit_message_model": {
      "provider": "opencode",
      "model": "opencode-go/deepseek-v4-flash",
    },
  },

  "tab_size": 2,
  "languages": {
    "Markdown": {
      "use_on_type_format": true,
    },
    "Rust": {},
    "TypeScript": {
      "format_on_save": "on",
      "indent_guides": {},
      "tab_size": 2,
      "formatter": "language_server",
    },
    "JavaScript": {
      "formatter": "language_server",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Base Charmed Icons",
    "dark": "Zed (Default)",
  },
  "agent_servers": {
    "glm-acp-agent": {
      "type": "registry",
    },
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "ui_font_size": 20.0,
  "buffer_line_height": {
    "custom": 2,
  },
  "agent_ui_font_size": 19.0,
  "agent_buffer_font_size": 19.0,
  "theme_overrides": {
    "Tokyo Night": {
      "border": "#16161e",
      "border.variant": "#16161e",
    },
    "One Dark Pro": {
      "border": "#23272E",
      "border.variant": "#23272E",
    },
    "Everforest Dark Medium (material)": {
      "border": "#2d353b",
      "border.variant": "#2d353b",
    },
    "Flexoki Dark": {
      "border": "#100f0f",
      "border.variant": "#100f0f",
      "title_bar.background": "#100f0f",
      "panel.background": "#100f0f",
    },
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "pane.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "db9dff",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_user_menu": true,
    "show_user_picture": true,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": true,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "cursor_position_button": false,
    "experimental.show": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "xlarge",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "breakpoints": false,
  },
  "indent_guides": {
    "enabled": false,
  },
}
